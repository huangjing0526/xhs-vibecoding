# 对标账号采集服务配置。复制成 .env 后填写：
#   cp .env.example .env
# 启动：set -a && source .env && set +a && python3 server.py

# MediaCrawler 仓库根目录（不配则只能起服务、不能真实采集）
MEDIACRAWLER_DIR=/path/to/MediaCrawler

# 跑 MediaCrawler 的解释器。它要求 Python >= 3.11，务必指向它自己的 venv，
# 不要用系统 python3（macOS 自带 3.9，会直接起不来）
MEDIACRAWLER_PYTHON=/path/to/MediaCrawler/venv/bin/python

# 登录方式：
#   qrcode — 首次用，会弹出浏览器让你扫码（需要人在场）
#   cookie — 无人值守，配合下面的 MEDIACRAWLER_COOKIES
MEDIACRAWLER_LOGIN_TYPE=qrcode

# 从浏览器复制的 cookie 串（LOGIN_TYPE=cookie 时必填）。
# 小红书：登录后打开 DevTools → Application → Cookies，复制 a1 / web_session 等整串
# MEDIACRAWLER_COOKIES=

# 单次采集超时（秒）。扫码登录那次要留足时间
MEDIACRAWLER_TIMEOUT_SEC=300

# 追加给 MediaCrawler 的额外参数（空格分隔），用于适配版本差异而不改代码
# 例：MEDIACRAWLER_ARGS=--enable_get_comments false
# MEDIACRAWLER_ARGS=

# ── TikTok 后端（yt-dlp）────────────────────────────────────────────
# MediaCrawler 不支持 TikTok，这条线独立走 yt-dlp。装好 yt-dlp 就能用，
# 下面几项**通常都不用配**，实测公开主页不登录就能抓。

# yt-dlp 可执行文件。brew install yt-dlp 后在 PATH 里，一般不用改
# YTDLP_BIN=yt-dlp

# 国内网络到不了 TikTok 时填代理
# YTDLP_PROXY=http://127.0.0.1:7890

# 风控要求登录时才需要：浏览器导出的 Netscape 格式 cookies.txt
# YTDLP_COOKIES_FILE=/path/to/cookies.txt

# 单次 TikTok 采集超时（秒）
YTDLP_TIMEOUT_SEC=300

# 本服务监听端口，需与主项目 .env.local 的 BLOGGER_COLLECTOR_URL 对上
PORT=8788
