# AI Provider 配置 (选择其中一种)
# 支持: gemini, siliconflow, openai, anthropic, custom

# 1. Gemini
# Get your API key from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# 2. 硅基流动 (国内推荐)
# Get your API key from https://cloud.siliconflow.cn/account/ak
# SILICONFLOW_API_KEY=sk-xxx
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 3. OpenAI (GPT)
# Get your API key from https://platform.openai.com/
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini

# 4. Anthropic (Claude)
# Get your API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 5. Custom (兼容 OpenAI 格式的 API)
# CUSTOM_API_KEY=your_key
# CUSTOM_API_BASE=https://api.example.com/v1
# CUSTOM_MODEL=your-model-name

# 优先级: GEMINI > SILICONFLOW > OPENAI > ANTHROPIC > CUSTOM

# 6. 共享免费试用 (供未配置 API Key 的用户免费体验，每人 3 次)
# SHARED_API_KEY=sk-xxx
# SHARED_API_PROVIDER=siliconflow
# SHARED_API_MODEL=Qwen/Qwen2.5-7B-Instruct
# SHARED_API_BASE=https://api.siliconflow.cn/v1

# 7. 飞书小红书内容闭环配置
# 飞书国内版默认使用 https://open.feishu.cn；Lark 国际版可改为 https://open.larksuite.com
# FEISHU_API_BASE=https://open.feishu.cn
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_BASE_APP_TOKEN=appxxx

# 多维表格 Table ID
# FEISHU_MATERIAL_TABLE_ID=tblxxx
# FEISHU_GLOSSARY_TABLE_ID=tblxxx
# FEISHU_TOPIC_TABLE_ID=tblxxx
# FEISHU_DRAFT_TABLE_ID=tblxxx
# FEISHU_REVIEW_TABLE_ID=tblxxx

# 8. 本地协作记录目录（用于同步日报、问题记录、Agent 学习和协作标准）
# LOCAL_DOCS_SOURCE_DIR=/Users/kp/AI学习与开发/TarmeerCRM2.0/docs/06-协作记录

# 9. 本地视频渲染服务地址（services/video-renderer，仅本地/自托管，不进 Cloudflare 部署）
# VIDEO_RENDERER_URL=http://localhost:8787
